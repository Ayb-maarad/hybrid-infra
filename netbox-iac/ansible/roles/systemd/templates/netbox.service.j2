[Unit]
Description=NetBox WSGI Service
Documentation=https://netboxlabs.com/docs/netbox/
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User={{ netbox_system_user }}
Group={{ netbox_system_user }}
WorkingDirectory={{ netbox_app }}/netbox
ExecStart=/opt/netbox/venv/bin/gunicorn --pythonpath /opt/netbox/app/netbox --bind 0.0.0.0:8001 --workers 2 --threads 2 --timeout 120 netbox.wsgi
Restart=on-failure
RestartSec=30
PrivateTmp=true

[Install]
WantedBy=multi-user.target