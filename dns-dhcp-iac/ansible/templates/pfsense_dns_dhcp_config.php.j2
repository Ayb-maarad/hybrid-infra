<?php
/*
 * pfSense DHCP + DNS Forwarding configuration
 * Generated by Ansible
 */

require_once("config.inc");
require_once("services.inc");

global $config;

$site_id = "{{ site_id }}";
$site_name = "{{ pfsense_sites[site_id].name }}";
$interface = "{{ pfsense_sites[site_id].interface }}";

$domain = "{{ pfsense_sites[site_id].domain }}";
$gateway = "{{ pfsense_sites[site_id].gateway }}";
$dns_server = "{{ pfsense_sites[site_id].dns_server }}";
$dhcp_from = "{{ pfsense_sites[site_id].dhcp_range_start }}";
$dhcp_to = "{{ pfsense_sites[site_id].dhcp_range_end }}";

$host_overrides = json_decode('{{ pfsense_sites[site_id].host_overrides | to_json }}', true);
$domain_override = json_decode('{{ pfsense_sites[site_id].domain_override | to_json }}', true);

function ensure_array_path(&$array, $key) {
    if (!isset($array[$key]) || !is_array($array[$key])) {
        $array[$key] = array();
    }
}

function remove_host_override($host, $domain) {
    global $config;

    if (!isset($config['unbound']['hosts']) || !is_array($config['unbound']['hosts'])) {
        $config['unbound']['hosts'] = array();
        return;
    }

    $new_hosts = array();

    foreach ($config['unbound']['hosts'] as $entry) {
        $entry_host = isset($entry['host']) ? $entry['host'] : "";
        $entry_domain = isset($entry['domain']) ? $entry['domain'] : "";

        if ($entry_host === $host && $entry_domain === $domain) {
            continue;
        }

        $new_hosts[] = $entry;
    }

    $config['unbound']['hosts'] = $new_hosts;
}

function remove_domain_override($domain) {
    global $config;

    if (!isset($config['unbound']['domainoverrides']) || !is_array($config['unbound']['domainoverrides'])) {
        $config['unbound']['domainoverrides'] = array();
        return;
    }

    $new_domains = array();

    foreach ($config['unbound']['domainoverrides'] as $entry) {
        $entry_domain = isset($entry['domain']) ? $entry['domain'] : "";

        if ($entry_domain === $domain) {
            continue;
        }

        $new_domains[] = $entry;
    }

    $config['unbound']['domainoverrides'] = $new_domains;
}

/*
 * DHCP Server configuration
 */
ensure_array_path($config, 'dhcpd');
ensure_array_path($config['dhcpd'], $interface);

$config['dhcpd'][$interface]['enable'] = "";
$config['dhcpd'][$interface]['range'] = array(
    "from" => $dhcp_from,
    "to" => $dhcp_to
);
$config['dhcpd'][$interface]['gateway'] = $gateway;
$config['dhcpd'][$interface]['domain'] = $domain;
$config['dhcpd'][$interface]['dnsserver'] = array($dns_server);
$config['dhcpd'][$interface]['defaultleasetime'] = "7200";
$config['dhcpd'][$interface]['maxleasetime'] = "86400";

/*
 * DNS Resolver / Unbound configuration
 */
ensure_array_path($config, 'unbound');

$config['unbound']['enable'] = "";

if (!isset($config['unbound']['hosts']) || !is_array($config['unbound']['hosts'])) {
    $config['unbound']['hosts'] = array();
}

if (!isset($config['unbound']['domainoverrides']) || !is_array($config['unbound']['domainoverrides'])) {
    $config['unbound']['domainoverrides'] = array();
}

/*
 * Host Overrides
 */
foreach ($host_overrides as $record) {
    remove_host_override($record['host'], $record['domain']);

    $config['unbound']['hosts'][] = array(
        "host" => $record['host'],
        "domain" => $record['domain'],
        "ip" => $record['ip'],
        "descr" => $record['descr']
    );
}

/*
 * Domain Override
 */
remove_domain_override($domain_override['domain']);

$config['unbound']['domainoverrides'][] = array(
    "domain" => $domain_override['domain'],
    "ip" => $domain_override['ip'],
    "descr" => $domain_override['descr']
);

/*
 * Save configuration and reload services
 */
write_config("Ansible: DHCP and DNS forwarding configuration for " . $site_name);

echo "Configuration written for " . $site_name . PHP_EOL;

if (function_exists('services_dhcpd_configure')) {
    services_dhcpd_configure();
    echo "DHCP service reconfigured" . PHP_EOL;
} else {
    echo "WARNING: services_dhcpd_configure() not available" . PHP_EOL;
}

if (function_exists('services_unbound_configure')) {
    services_unbound_configure();
    echo "DNS Resolver / Unbound reconfigured" . PHP_EOL;
} else {
    echo "WARNING: services_unbound_configure() not available" . PHP_EOL;
}

echo "Done" . PHP_EOL;
?>