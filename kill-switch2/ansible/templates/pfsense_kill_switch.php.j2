<?php
/*
 * pfSense Kill Switch 2
 * Generated by Ansible
 */

require_once("config.inc");
require_once("filter.inc");

global $config;

$state = "{{ kill_switch_state }}";
$site_id = "{{ site_id }}";
$marker = "{{ kill_switch_marker }}";
$site_name = "{{ kill_switch_sites[site_id].name }}";

$interfaces = json_decode('{{ kill_switch_interfaces | to_json }}', true);
$bastion_ip = "{{ kill_switch_bastion_ip }}";
$user_networks = json_decode('{{ kill_switch_user_networks | to_json }}', true);
$services = json_decode('{{ kill_switch_sites[site_id].services | to_json }}', true);

function ensure_filter_rules() {
    global $config;

    if (!isset($config['filter']) || !is_array($config['filter'])) {
        $config['filter'] = array();
    }

    if (!isset($config['filter']['rule']) || !is_array($config['filter']['rule'])) {
        $config['filter']['rule'] = array();
    }
}

function remove_marked_rules($marker) {
    global $config;

    ensure_filter_rules();
    $kept_rules = array();
    $removed = 0;

    foreach ($config['filter']['rule'] as $rule) {
        $descr = isset($rule['descr']) ? $rule['descr'] : "";

        if (strpos($descr, $marker) !== false) {
            $removed++;
            continue;
        }

        $kept_rules[] = $rule;
    }

    $config['filter']['rule'] = $kept_rules;
    return $removed;
}

function make_tcp_rule($type, $interfaces, $source_address, $destination_address, $destination_port, $descr, $marker) {
    return array(
        "type" => $type,
        "interface" => $interfaces,
        "floating" => "yes",
        "quick" => "yes",
        "direction" => "in",
        "ipprotocol" => "inet",
        "protocol" => "tcp",
        "source" => array(
            "address" => $source_address
        ),
        "destination" => array(
            "address" => $destination_address,
            "port" => (string)$destination_port
        ),
        "descr" => $marker . " - " . $descr,
        "statetype" => "keep state"
    );
}

function prepend_rules($rules) {
    global $config;

    ensure_filter_rules();
    $config['filter']['rule'] = array_merge($rules, $config['filter']['rule']);
}

ensure_filter_rules();

$removed = remove_marked_rules($marker);
echo "Removed " . $removed . " existing " . $marker . " rule(s)" . PHP_EOL;

if ($state === "soft" || $state === "hard") {
    $new_rules = array();

    foreach ($services as $service) {
        foreach ($service['ports'] as $port) {
            $new_rules[] = make_tcp_rule(
                "pass",
                $interfaces,
                $bastion_ip,
                $service['ip'],
                $port,
                "allow bastion to " . $service['name'] . " tcp/" . $port,
                $marker
            );
        }
    }

    foreach ($services as $service) {
        foreach ($user_networks as $network) {
            foreach ($service['ports'] as $port) {
                $new_rules[] = make_tcp_rule(
                    "block",
                    $interfaces,
                    $network,
                    $service['ip'],
                    $port,
                    "block users to " . $service['name'] . " tcp/" . $port,
                    $marker
                );
            }
        }
    }

    prepend_rules($new_rules);
    echo "Added " . count($new_rules) . " " . $marker . " rule(s) for " . $site_name . PHP_EOL;
} else {
    echo "State is off; no new rules added for " . $site_name . PHP_EOL;
}

write_config("Ansible: " . $marker . " state " . $state . " for " . $site_name);

echo "Configuration written. Filter reload is handled by Ansible." . PHP_EOL;
echo "Done" . PHP_EOL;
?>
